# Copie para app/.env. Só valores públicos: a chave publishable é feita para o app (protegida por RLS).
# Nunca coloque aqui a chave secret do Supabase nem a do OpenRouter.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Opcional: endereço do backend. Em desenvolvimento, o app usa o IP do Metro na porta 8000.
EXPO_PUBLIC_API_URL=
