{
  "expo": {
    "name": "SempreAqui",
    "slug": "sempreaqui",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "O SempreAqui usa o microfone para você contar como foi o dia por voz.",
        "NSLocalNetworkUsageDescription": "O SempreAqui conversa com o servidor da família na sua rede para organizar os relatos.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSSpeechRecognitionUsageDescription": "O SempreAqui transcreve seus relatos aqui no celular, sem enviar o áudio para fora dele."
      },
      "bundleIdentifier": "com.lucasarais.sempreaqui"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lucasarais.sempreaqui"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-image",
      [
        "expo-audio",
        {
          "microphonePermission": "O SempreAqui usa o microfone para você contar como foi o dia por voz."
        }
      ],
      "expo-sharing",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/simbolo.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "scheme": "sempreaqui",
    "experiments": {
      "typedRoutes": true
    }
  }
}
