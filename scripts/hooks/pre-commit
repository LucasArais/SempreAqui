#!/usr/bin/env bash
# Bloqueia commits que contenham chaves ou arquivos .env.
# Instale uma vez com: bash scripts/instalar-hooks.sh
set -euo pipefail

falhou=0

# 1. Nenhum arquivo .env (exceto .env.example) pode entrar no commit.
while IFS= read -r arquivo; do
  case "$(basename "$arquivo")" in
    .env.example) ;;
    .env|.env.*) echo "Bloqueado: $arquivo é um arquivo de segredos e não pode ser versionado."; falhou=1 ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

# 2. Nenhuma linha adicionada pode parecer uma chave.
PADRAO='(sk-or-v1-[0-9a-f]{20,}|sb_secret_[A-Za-z0-9_-]{10,}|sb_publishable_[A-Za-z0-9_-]{10,}|AIza[0-9A-Za-z_-]{30,}|sk-[A-Za-z0-9]{32,}|eyJhbGciOi[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,})'
if git diff --cached -U0 --diff-filter=ACMR | grep -E '^\+' | grep -v '^+++' | grep -Eq "$PADRAO"; then
  echo "Bloqueado: o commit contém algo que parece uma chave de API."
  git diff --cached -U0 --diff-filter=ACMR --name-only -G "$PADRAO" | sed 's/^/  em: /'
  falhou=1
fi

if [ "$falhou" -ne 0 ]; then
  echo "Coloque segredos só no .env (que é ignorado pelo git)."
  exit 1
fi
