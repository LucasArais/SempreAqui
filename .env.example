# Copie para .env e preencha. Nunca versione o .env.

# Provedor de IA: "openrouter" (vários modelos com uma chave) ou "gemini" (API do Google direto).
# A camada de abstração permite trocar sem mudar código.
LLM_PROVIDER=openrouter

# OpenRouter: https://openrouter.ai/keys . Defina um limite de gasto na chave.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3-flash-preview

# Gemini direto: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo usado para transcrição, extração e resumo
GEMINI_MODEL=gemini-2.5-flash
# Modelo de embeddings para o RAG de fontes oficiais
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Banco de dados (docker-compose sobe um Postgres com pgvector localmente)
POSTGRES_USER=sempreaqui
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=sempreaqui
DATABASE_URL=postgresql://sempreaqui:troque-esta-senha@localhost:5432/sempreaqui

# Supabase. A publishable pode ir para o app (protegida por RLS).
# A secret NUNCA sai do backend.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Connection string do pooler (Project Settings, Database). Só no backend.
SUPABASE_DATABASE_URL=
# "supabase" ou "local" (SQLite em DADOS_DIR, sem internet)
REPOSITORIO=supabase

# API
API_HOST=0.0.0.0
API_PORT=8000
# Em produção, nunca "debug". Logs nunca recebem conteúdo de relatos, transcrições ou nomes.
LOG_LEVEL=info

# Onde o backend guarda relatos e áudios enquanto o Supabase não está ligado
DADOS_DIR=dados

# App Expo: endereço da API. Opcional em desenvolvimento: o app descobre o IP do Metro sozinho.
EXPO_PUBLIC_API_URL=
