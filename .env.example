# Copie para .env e preencha. Nunca versione o .env.

# Provedor de IA. Hoje: "gemini". A camada de abstração permite trocar sem mudar código.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Modelo usado para transcrição, extração e resumo
GEMINI_MODEL=gemini-2.5-flash
# Modelo de embeddings para o RAG de fontes oficiais
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Banco de dados (docker-compose sobe um Postgres com pgvector localmente)
POSTGRES_USER=sempreaqui
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=sempreaqui
DATABASE_URL=postgresql://sempreaqui:troque-esta-senha@localhost:5432/sempreaqui

# Supabase (opcional, para deploy). Deixe vazio para usar o Postgres local.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# API
API_HOST=0.0.0.0
API_PORT=8000
# Em produção, nunca "debug". Logs nunca recebem conteúdo de relatos, transcrições ou nomes.
LOG_LEVEL=info

# App Expo: endereço da API visto pelo celular (use o IP da sua máquina na rede local)
EXPO_PUBLIC_API_URL=http://192.168.0.10:8000
